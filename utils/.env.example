# Copy to utils/.env (git-ignored) and edit: Compose reads it for every run. A variable set in the shell wins over it.
# All of these are described in README.md, under Overrides.

# Gradle tasks, space-separated. assembleDebug: quick, not optimised. assembleRelease: smaller and faster.
GRADLE_TASK=assembleRelease

# Application ID. Unlike the official dev.alder, it installs beside it with its own data. Empty: dev.alder.
APP_ID=dev.alder.dockerbuilt

# Name on the TV's home screen and app list. Unset: Alder.
APP_NAME=Alder (Docker)

# The user the build runs as, who owns utils/output and utils/cache. Set to `id -u` / `id -g` if not 1000.
# Changing them needs --build once.
# HOST_UID=1000
# HOST_GID=1000

# The SDK in the image, for when the Android Gradle plugin asks for other versions. Changing them needs --build once.
# ANDROID_PLATFORM=android-36
# BUILD_TOOLS_VERSION=36.0.0
# CMDLINE_TOOLS_VERSION=13114758

# The release signing key, used by release builds when utils/keys/release.jks exists (README.md, Signing with your own
# key). Without it, release builds use the debug key. Keep this file private: chmod 600 utils/.env
# SIGNING_STORE_PASSWORD=
# Only when they differ from the defaults (key password: the store's, as PKCS12 keystores have one password):
# SIGNING_KEY_ALIAS=alder
# SIGNING_KEY_PASSWORD=
# SIGNING_KEYSTORE=/utils/keys/release.jks
